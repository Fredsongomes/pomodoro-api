# Senha do Postgres (obrigatória para o docker-compose)
DB_PASSWORD=troque-esta-senha

# Porta do Postgres no host (opcional, padrão 5432).
# Troque (ex.: 5433) se já tiver um Postgres instalado usando a 5432.
DB_PORT=5432

# Porta da API no host (opcional, padrão 8080)
API_PORT=8080

# ---------------------------------------------------------------
# As variáveis abaixo só são usadas ao rodar a API FORA do Docker
# (ex.: pelo IntelliJ ou ./mvnw spring-boot:run). O Spring não lê
# este arquivo sozinho: defina-as no terminal ou na Run Configuration.
#
# Padrão: jdbc:postgresql://localhost:5432/pomodoro
# ---------------------------------------------------------------
# DB_URL=jdbc:postgresql://localhost:5432/pomodoro
# DB_USERNAME=postgres
